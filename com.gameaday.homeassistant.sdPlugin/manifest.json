{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Author": "Gameaday",
	"Category": "Home Assistant",
	"CategoryIcon": "imgs/plugin/category",
	"CodePath": "bin/plugin.js",
	"Description": "Control and monitor your Home Assistant smart home directly from your Stream Deck. Toggle entities, call services, activate scenes, and display live entity states — with full Stream Deck + dial support.",
	"Icon": "imgs/plugin/icon",
	"Name": "Home Assistant",
	"Nodejs": {
		"Version": "20",
		"Debug": "enabled"
	},
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.0"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "13"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"URL": "https://github.com/Gameaday/Elgato-Home-Assistant",
	"SupportURL": "https://github.com/Gameaday/Elgato-Home-Assistant/issues",
	"UUID": "com.gameaday.homeassistant",
	"Version": "2.1.0.0",
	"Actions": [
		{
			"Icon": "imgs/actions/toggle/icon",
			"Name": "Toggle Entity",
			"UUID": "com.gameaday.homeassistant.toggle",
			"Tooltip": "Toggle any Home Assistant entity on or off. Supports Stream Deck + dials: press to toggle, rotate to adjust brightness.",
			"Controllers": ["Keypad", "Encoder"],
			"DisableAutomaticStates": true,
			"Encoder": {
				"Icon": "imgs/actions/toggle/encoder/icon",
				"layout": "layouts/toggle-layout.json",
				"TriggerDescription": {
					"Push": "Toggle",
					"Rotate": "Brightness",
					"Touch": "Toggle"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/toggle/off",
					"Name": "Off",
					"TitleAlignment": "bottom",
					"FontSize": 12
				},
				{
					"Image": "imgs/actions/toggle/on",
					"Name": "On",
					"TitleAlignment": "bottom",
					"FontSize": 12
				}
			],
			"PropertyInspectorPath": "ui/toggle.html",
			"SupportedInMultiActions": true,
			"UserTitleEnabled": true
		},
		{
			"Icon": "imgs/actions/call-service/icon",
			"Name": "Call Service",
			"UUID": "com.gameaday.homeassistant.call-service",
			"Tooltip": "Call any Home Assistant service with optional JSON service data payload.",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/call-service/icon",
					"Name": "Default"
				}
			],
			"PropertyInspectorPath": "ui/call-service.html",
			"SupportedInMultiActions": true,
			"UserTitleEnabled": true
		},
		{
			"Icon": "imgs/actions/monitor/icon",
			"Name": "Monitor State",
			"UUID": "com.gameaday.homeassistant.monitor",
			"Tooltip": "Display the live state of any Home Assistant entity. Updates in real time via WebSocket. Supports Stream Deck + dial touchscreen display.",
			"Controllers": ["Keypad", "Encoder"],
			"Encoder": {
				"Icon": "imgs/actions/monitor/encoder/icon",
				"layout": "layouts/monitor-layout.json",
				"TriggerDescription": {
					"Rotate": "Browse entities",
					"Touch": "Refresh"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/monitor/icon",
					"Name": "Default"
				}
			],
			"PropertyInspectorPath": "ui/monitor.html",
			"SupportedInMultiActions": false,
			"UserTitleEnabled": false,
			"DisableCaching": true
		},
		{
			"Icon": "imgs/actions/scene/icon",
			"Name": "Activate Scene",
			"UUID": "com.gameaday.homeassistant.scene",
			"Tooltip": "Activate a Home Assistant scene instantly from your Stream Deck.",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/scene/icon",
					"Name": "Default"
				}
			],
			"PropertyInspectorPath": "ui/scene.html",
			"SupportedInMultiActions": true,
			"UserTitleEnabled": true
		}
	]
}
